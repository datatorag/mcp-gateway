{
  "name": "datatorag-mcp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:gateway": "turbo run dev --filter=@datatorag-mcp/gateway",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "hono@>=4.12.8 <4.12.10": "4.12.10",
      "@hono/node-server@>=1.19.11 <1.19.12": "1.19.12",
      "express-rate-limit@>=8.3.1 <8.3.2": "8.3.2",
      "path-to-regexp@>=8.0.0 <8.4.2": "8.4.2",
      "zod-to-json-schema@>=3.25.1 <3.25.2": "3.25.2"
    }
  }
}
