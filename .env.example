# ── Team members: don't fill this in by hand ─────────────────────────
# Both dev and prod env files render from AWS SSM Parameter Store:
#   dev:  AWS_PROFILE=<your-profile> ./scripts/render-env.sh /datatorag-mcp/dev .env
#   prod: rendered on the server at deploy (see the deploy skill)
# Edit a value with `aws ssm put-parameter --overwrite`, then re-render.
# This file documents the variables for contributors without SSM access.

# Database — any Postgres; the dev stack does not start one for you.
DATABASE_URL=postgresql://user:password@host:5432/datatoragmcp

# Gateway (serves both API and web UI)
GATEWAY_PORT=8285
GATEWAY_BASE_URL=http://localhost:8285

# Google OAuth — web login (minimal scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth — GWS connection (Workspace scopes)
GOOGLE_GWS_CLIENT_ID=
GOOGLE_GWS_CLIENT_SECRET=

# Atlassian OAuth — Jira + Confluence
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# PostHog (analytics)
# Server-side SDK — writes tool_call, login, signup, OAuth events
POSTHOG_API_KEY=
# Client-side JS — safe to expose (PostHog project keys are public). Usually same value as POSTHOG_API_KEY.
NEXT_PUBLIC_POSTHOG_KEY=
# Analytics is OFF outside production (NODE_ENV != production) no matter what
# keys are set. Setting these sends this machine's events to the PRODUCTION
# PostHog project, so leave them unset unless that is the decision.
# POSTHOG_ALLOW_NONPRODUCTION=1
# NEXT_PUBLIC_POSTHOG_ALLOW_NONPRODUCTION=1

# Google Ads — conversion tracking
# The global tag ID (AW-18240284968) is hardcoded in the GoogleAds component.
# This is the per-action conversion LABEL from Google Ads (Goals → Conversions),
# e.g. "AbC-dEfG12345". Until set, the /demo form fires no conversion event.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Same, for the account-signup conversion action. Fired on /dashboard?signup=1
# (first-time OAuth login). Until set, signups fire no conversion event.
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=

# Stripe (paid tiers)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Promo campaign (SCRUM-231): the Stripe promotion code id (promo_...) applied at checkout
# when a visitor arrives with the campaign code. Empty = the hosted page shows the code field.
STRIPE_PROMOTION_CODE_ID=
STRIPE_PAYG_PRICE_ID=
STRIPE_METER_ID=
STRIPE_METER_EVENT_NAME=tool_calls

# Cron — Bearer token required to hit /api/cron/* externally
CRON_SECRET=

# Public URL used in Stripe Checkout return / email links
PUBLIC_APP_URL=http://localhost:8285

# Salt for hashing visitor IPs in the leads table (any random string; rotate to invalidate old hashes)
LEADS_IP_SALT=

# GitHub (Phase 5)
# GITHUB_TOKEN=

# ── Secrets management ────────────────────────────────────────────────
# Production values live in AWS SSM Parameter Store: /datatorag-mcp/prd/<VAR>
# (region us-west-2). Render with: scripts/render-env.sh
# Local dev: fill this file manually; it is gitignored as .env.

# Slack notifications — posted by the Dara bot (chat:write). Empty = disabled.
# Token: Slack app "Dara" → OAuth & Permissions → Bot User OAuth Token (xoxb-…)
# Channel ids: channel → View channel details → ID (bot must be /invite'd)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_LEADS=
SLACK_CHANNEL_DIGEST=
SLACK_CHANNEL_ALERTS=
# PostHog Query API (daily digest) — personal API key (NOT the ingestion key) + numeric project id
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Internal/test traffic excluded from digest analytics (comma-separated email
# and user-id/distinct_id lists). @datatorag.com is always excluded in code;
# these add personal/test accounts. Keep mirrored with the PostHog
# "Internal / Test users" cohort. Values live in SSM, never in the repo.
INTERNAL_EXCLUDE_EMAILS=
INTERNAL_EXCLUDE_IDS=

# Dashboard playground — server-side LLM loop. Key lives in SSM, never here.
ANTHROPIC_API_KEY=
PLAYGROUND_MODEL=claude-sonnet-5
PLAYGROUND_MESSAGE_CAP=20

# Whether a NEW user is sent to the Agent after signup. "on" or "off".
#
# Defaults to "off" when the key is ABSENT. Turn it back off by DELETING the
# parameter or setting exactly "off" - never by blanking it. An empty string,
# "ON", or any other value fails validation and the gateway exits at boot
# rather than falling back, so a blanked value takes the whole service down
# instead of just the redirect.
AGENT_DEFAULT_VIEW=off
# Slack channel id for playground feedback
SLACK_CHANNEL_FEEDBACK=

# Brevo (lifecycle emails: welcome on signup + no-activation follow-up)
# Empty = feature disabled (logged no-op). Prod value: SSM /datatorag-mcp/prd/BREVO_API_KEY
BREVO_API_KEY=
# From/reply-to on the contact-form confirmation email. Must be a VERIFIED
# Brevo sender or every send is rejected. Replies are the email's primary
# ask, so this must be an inbox someone reads.
LEADS_CONFIRMATION_FROM=manuel@datatorag.com

# ---------------------------------------------------------------------------
# Test runner (SCRUM-303). The gateway runs its own suite against itself, as
# a client of its own MCP endpoint, started by an admin from /dashboard/admin.
# ---------------------------------------------------------------------------

# Where a run says it ran. Free text, recorded on every run row and compared
# by the local-vs-prod diff, so "local" and "prod" have to stay spelled the
# same way in both places or the diff has nothing to line up.
TEST_RUNNER_ENVIRONMENT=local

# Which account, user and file each case works against, as ONE JSON string.
#
# EMPTY IS A WORKING CONFIGURATION and the default: a case whose mapping is
# absent SKIPS, naming what was missing. It never falls back to a default
# account, because a test that silently ran as the wrong account reports a
# pass about something nobody checked.
#
# Cases name a ROLE and a KEY, never an address or an id, so this repository
# stays free of both. The shape, with every value elided:
#
#   {"accounts":{"sender":"","reader":"","atlassian":""},
#    "users":{"nonAdmin":""},
#    "fixtures":{"sheet":"","scratchTab":"","folder":"","doc":"","deck":"",
#                "calendarEvent":"","tasklist":"","jiraProject":"",
#                "jiraAttachmentIssue":"","confluenceSpace":"",
#                "confluenceAttachmentPage":"","querySheet":"","queryTab":""}}
#
# The key list here is what an operator copies, so it tracks FIXTURE_KEYS in
# apps/gateway/src/gateway/tests/types.ts. It had drifted three keys behind.
# `tasklist` exists because the connector can create a tasklist and cannot
# delete one, so no case may make its own.
#
# accounts.reader is the ONLY address any test may send to; the send guard
# compares against it and refuses everything else. users.nonAdmin is a USER
# ID, not an address, and is re-validated at use as a uuid holding role
# "user" at our own domain. Prod value: SSM /datatorag-mcp/prd/TEST_RUNNER_FIXTURES
TEST_RUNNER_FIXTURES=

# The commit this image was built from, baked in at deploy time. A run
# records it so two runs can be compared; absent, the run says "sha unknown"
# rather than guessing.
GATEWAY_SHA=
