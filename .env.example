# ── Team members: don't fill this in by hand ─────────────────────────
# Both dev and prod env files render from AWS SSM Parameter Store:
#   dev:  AWS_PROFILE=<your-profile> ./scripts/render-env.sh /datatorag-mcp/dev .env
#   prod: rendered on the server at deploy (see the deploy skill)
# Edit a value with `aws ssm put-parameter --overwrite`, then re-render.
# This file documents the variables for contributors without SSM access.

# Database
DATABASE_URL=postgresql://datatoragmcp:localdev@localhost:54320/datatoragmcp

# Gateway (serves both API and web UI)
GATEWAY_PORT=8285
GATEWAY_BASE_URL=http://localhost:8285

# Google OAuth — web login (minimal scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth — GWS connection (Workspace scopes)
GOOGLE_GWS_CLIENT_ID=
GOOGLE_GWS_CLIENT_SECRET=

# Atlassian OAuth — Jira + Confluence
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# PostHog (analytics)
# Server-side SDK — writes tool_call, login, signup, OAuth events
POSTHOG_API_KEY=
# Client-side JS — safe to expose (PostHog project keys are public). Usually same value as POSTHOG_API_KEY.
NEXT_PUBLIC_POSTHOG_KEY=

# Google Ads — conversion tracking
# The global tag ID (AW-18240284968) is hardcoded in the GoogleAds component.
# This is the per-action conversion LABEL from Google Ads (Goals → Conversions),
# e.g. "AbC-dEfG12345". Until set, the /demo form fires no conversion event.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Same, for the account-signup conversion action. Fired on /dashboard?signup=1
# (first-time OAuth login). Until set, signups fire no conversion event.
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=

# Stripe (paid tiers)
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PAYG_PRICE_ID=
STRIPE_METER_ID=
STRIPE_METER_EVENT_NAME=tool_calls

# Cron — Bearer token required to hit /api/cron/* externally
CRON_SECRET=

# Public URL used in Stripe Checkout return / email links
PUBLIC_APP_URL=http://localhost:8285

# Salt for hashing visitor IPs in the leads table (any random string; rotate to invalidate old hashes)
LEADS_IP_SALT=

# GitHub (Phase 5)
# GITHUB_TOKEN=

# ── Secrets management ────────────────────────────────────────────────
# Production values live in AWS SSM Parameter Store: /datatorag-mcp/prd/<VAR>
# (region us-west-2). Render with: scripts/render-env.sh
# Local dev: fill this file manually; it is gitignored as .env.

# Slack notifications — posted by the Dara bot (chat:write). Empty = disabled.
# Token: Slack app "Dara" → OAuth & Permissions → Bot User OAuth Token (xoxb-…)
# Channel ids: channel → View channel details → ID (bot must be /invite'd)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_LEADS=
SLACK_CHANNEL_DIGEST=
SLACK_CHANNEL_ALERTS=
# PostHog Query API (daily digest) — personal API key (NOT the ingestion key) + numeric project id
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Internal/test traffic excluded from digest analytics (comma-separated email
# and user-id/distinct_id lists). @datatorag.com is always excluded in code;
# these add personal/test accounts. Keep mirrored with the PostHog
# "Internal / Test users" cohort. Values live in SSM, never in the repo.
INTERNAL_EXCLUDE_EMAILS=
INTERNAL_EXCLUDE_IDS=

# Dashboard playground — server-side LLM loop. Key lives in SSM, never here.
ANTHROPIC_API_KEY=
PLAYGROUND_MODEL=claude-sonnet-5
PLAYGROUND_MESSAGE_CAP=20
# Slack channel id for playground feedback
SLACK_CHANNEL_FEEDBACK=

# Brevo (lifecycle emails: welcome on signup + no-activation follow-up)
# Empty = feature disabled (logged no-op). Prod value: SSM /datatorag-mcp/prd/BREVO_API_KEY
BREVO_API_KEY=
