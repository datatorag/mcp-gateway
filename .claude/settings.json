{
  "enabledPlugins": {
    "interface-design@interface-design": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/pattern-check-on-push.mjs\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_neon_neon__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/db-guard.py\"",
            "statusMessage": "DB guard: classifying SQL"
          }
        ]
      }
    ]
  }
}
