{
  "enabledPlugins": {
    "interface-design@interface-design": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/pattern-check-on-push.mjs\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/db-client-guard.py\"",
            "statusMessage": "DB client guard: checking for direct database clients"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/protect-dev-targets.py\"",
            "statusMessage": "Dev targets guard: the allowlist is a human's to edit"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_neon_neon__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/db-guard.py\"",
            "statusMessage": "DB guard: classifying SQL"
          }
        ]
      }
    ]
  }
}
